DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
MAX_UPLOAD_BYTES=50000000
MAX_DOCUMENT_PAGES=1000
MAX_DOCUMENT_CHARS=5000000
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10

LLM_BASE_URL=http://localhost:11434/v1
PRIMARY_MODEL=llama3.2:1b
FALLBACK_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text
VECTOR_COLLECTION_NAME=documents
RETRIEVAL_K=4
RETRIEVAL_CANDIDATES_K=12
MAX_CONTEXT_CHARS=12000
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_COUNT=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_CANDIDATES_K=30

APP_ENV=development
TENANT_ID=local
INGEST_API_KEY=local-ingest-key
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Blank LANGSMITH_PROJECT uses prod-rag-<APP_ENV>, for example prod-rag-development.
LANGSMITH_PROJECT=
# Blank LANGSMITH_ENDPOINT uses https://api.smith.langchain.com (GCP US). Regional
# orgs must set their own API URL, for example https://eu.api.smith.langchain.com.
LANGSMITH_ENDPOINT=
LANGSMITH_TRACING_SAMPLING_RATE=1.0
# Blank hide flags trace prompts and answers in development and hide them in production.
LANGSMITH_HIDE_INPUTS=
LANGSMITH_HIDE_OUTPUTS=
RATE_LIMIT=20/minute
INGEST_RATE_LIMIT=5/minute
MAX_INGEST_CHARS=250000
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
# LLM runaway-cost guardrails: per-call estimated spend ceiling in USD and the
# cumulative budget in USD; blank disables the cumulative budget.
MAX_ESTIMATED_LLM_COST_PER_REQUEST_USD=0.05
MAX_TOTAL_LLM_COST_USD=

# Optional: only needed for a secured OpenAI-compatible endpoint or production chat auth.
LLM_API_KEY=
CHAT_API_KEY=
